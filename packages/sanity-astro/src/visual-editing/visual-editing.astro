---
import {FOLLOW_UP_RELOAD_KEY} from './follow-up-reload'
import {resolveRefreshStrategy} from './refresh-strategy'
import {VisualEditingComponent, type VisualEditingComponentProps} from './visual-editing-component'

export interface Props
  extends Pick<
    VisualEditingComponentProps,
    'zIndex' | 'keepStegaOnCopy' | 'experimental_refreshStrategy'
  > {
  enabled?: boolean
}

const {enabled, zIndex, keepStegaOnCopy, experimental_refreshStrategy} = Astro.props

// Normalize strategy at build/SSR time so the inline script receives a numeric delay.
const resolvedStrategy = resolveRefreshStrategy(experimental_refreshStrategy)
const followUpDelayMs = resolvedStrategy.followUpDelayMs ?? 0
---

{
  enabled ? (
  <>
    <script
        is:inline
        define:vars={{followUpDelayMs, flagKey: FOLLOW_UP_RELOAD_KEY}}
    >
      (function () {
        // Host-isolated cookie name matching middleware.ts
        const cookieName = `sanity-perspective-${window.location.host.replace(/[:.]/g, '-')}`

        function getCookiePerspective() {
          const match = document.cookie.match(
            new RegExp(`(?:^|;\\s*)${cookieName}=([^;]*)`),
          )
          return match ? decodeURIComponent(match[1]) : ''
        }

        function setCookiePerspective(val) {
          const attributes =
            window.location.protocol === 'https:'
              ? 'path=/; SameSite=None; Secure; Partitioned'
              : 'path=/; SameSite=Lax'
          document.cookie = `${cookieName}=${encodeURIComponent(val)}; ${attributes}`
        }

        function stripUrlPerspectiveParams() {
          const url = new URL(window.location.href)
          if (
            url.searchParams.has('sanity-preview-perspective') ||
            url.searchParams.has('perspective')
          ) {
            url.searchParams.delete('sanity-preview-perspective')
            url.searchParams.delete('perspective')
            window.history.replaceState(
              {},
              '',
              url.pathname + url.search + url.hash,
            )
          }
        }

        function syncPerspective(incomingPerspective) {
          if (window.self === window.top || !incomingPerspective) return

          const incoming = Array.isArray(incomingPerspective)
            ? incomingPerspective.join(',')
            : String(incomingPerspective)

          const currentCookie = getCookiePerspective() || 'published'

          if (incoming !== currentCookie) {
            setCookiePerspective(incoming)
            stripUrlPerspectiveParams()
            window.__sanityVEConfig?.acknowledgeRefresh?.()
            window.location.reload()
          }
        }

        // Expose synchronous refresh acknowledgement hook, perspective sync, and shared timer state
        // on window before deferred React island bundles download and hydrate.
        window.__sanityVEConfig = {
          syncPerspective: syncPerspective,
          acknowledgeRefresh: function () {
            try {
              sessionStorage.removeItem(flagKey)
            } catch {}
            window.__sanityPendingFollowUpUrl = null
            if (window.__sanityFallbackTimer) {
              clearTimeout(window.__sanityFallbackTimer)
              window.__sanityFallbackTimer = null
            }
          },
        }

        if (window.self === window.top) return

        // 1. PERSPECTIVE INITIAL SYNC & OBSERVE: Persist URL perspective param (if passed by Studio)
        // or initialize default, then strip the query param in-place so reloads read the cookie.
        // Runs unconditionally in the iframe even when followUpDelayMs is 0.
        const params = new URLSearchParams(window.location.search)
        const urlPerspective =
          params.get('sanity-preview-perspective') || params.get('perspective')
        const initialCookie = getCookiePerspective()
        const targetPerspective =
          urlPerspective || initialCookie || 'published'

        if (targetPerspective !== initialCookie) {
          setCookiePerspective(targetPerspective)
        }
        stripUrlPerspectiveParams()

        window.addEventListener('message', function (e) {
          if (e.data && e.data.type === 'presentation/perspective') {
            const rawPerspective =
              e.data.data?.perspective ?? e.data.perspective
            if (rawPerspective) {
              syncPerspective(rawPerspective)
            }
          }
        })

        if (!followUpDelayMs || followUpDelayMs <= 0) return

        // Mark that the inline observer is active so the React island does not attach duplicate listeners.
        window.__sanityFollowUpInstalled = true

        // 2. OBSERVE MUTATIONS: Monitor ONLY actual mutation events ('presentation/snapshot-event').
        // Ignoring 'presentation/preview-snapshots' prevents post-refresh and on-load
        // snapshot dumps from falsely re-arming flagKey after acknowledgeRefresh().
        window.addEventListener('message', function (e) {
          if (
            e.data &&
            e.data.type === 'presentation/snapshot-event' &&
            e.data.data &&
            e.data.data.event &&
            e.data.data.event.type === 'mutation'
          ) {
            try {
              sessionStorage.setItem(flagKey, window.location.href)
            } catch {}
            // Fallback if the page is already loaded and Comlink drops the accompanying refresh:
            // ensure a fallback reload still fires after followUpDelayMs.
            if (
              document.readyState === 'complete' &&
              !window.__sanityFallbackTimer
            ) {
              window.__sanityFallbackTimer = setTimeout(function () {
                window.__sanityFallbackTimer = null
                window.__sanityPendingFollowUpUrl = null
                try {
                  sessionStorage.removeItem(flagKey)
                } catch {}
                window.location.reload()
              }, followUpDelayMs)
            }
          }
        })

        // 3. RECONCILE: Check for missed updates on page arrival and consume sessionStorage immediately.
        window.addEventListener('load', function () {
          var storedHref = null
          try {
            storedHref = sessionStorage.getItem(flagKey)
            if (storedHref !== null) {
              sessionStorage.removeItem(flagKey)
            }
          } catch {}

          if (storedHref === window.location.href) {
            window.__sanityPendingFollowUpUrl = window.location.href
            if (!window.__sanityFallbackTimer) {
              window.__sanityFallbackTimer = setTimeout(function () {
                window.__sanityFallbackTimer = null
                window.__sanityPendingFollowUpUrl = null
                window.location.reload()
              }, followUpDelayMs)
            }
          }
        })
      })()
    </script>
    <VisualEditingComponent
        client:only="react"
        zIndex={zIndex}
        keepStegaOnCopy={keepStegaOnCopy}
        experimental_refreshStrategy={experimental_refreshStrategy}
    />
  </>
    ) : null
  }